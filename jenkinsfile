
pipeline {
    agent any

    options {
        skipStagesAfterUnstable()
        timestamps()
    }

    environment {
        PYTEST_FAILED = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'python -m pip install -r requirements.txt'
            }
        }

        stage('Run Automated Tests') {
            steps {
                script {
                    bat 'if exist pytest-output.txt del pytest-output.txt'

                    def testStatus = bat(
                        returnStatus: true,
                        script: 'python -m pytest --junitxml=test-results.xml --html=report.html --self-contained-html > pytest-output.txt 2>&1'
                    )

                    bat 'type pytest-output.txt'

                    if (testStatus != 0) {
                        env.PYTEST_FAILED = 'true'
                        error('Automated tests failed. Starting AI failure analysis.')
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t tms_img .'
            }
        }
    }

    post {
        always {
            junit testResults: 'test-results.xml',
                  allowEmptyResults: true

            archiveArtifacts artifacts: 'report.html,pytest-output.txt',
                             allowEmptyArchive: true
        }

        success {
            echo 'All tests passed successfully'
        }

        unstable {
            echo 'Build is unstable'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'

            script {
                if (env.PYTEST_FAILED == 'true') {
                    echo 'Starting Gemini AI failure analysis...'

                    try {
                        withCredentials([
                            string(
                                credentialsId: 'gemini-api-key',
                                variable: 'GEMINI_API_KEY'
                            )
                        ]) {
                            bat 'python -c "import os; print(chr(75) + chr(69) + chr(89) + chr(95) + chr(80) + chr(82) + chr(69) + chr(83) + chr(69) + chr(78) + chr(84) + chr(61) + str(bool(os.getenv(chr(71) + chr(69) + chr(77) + chr(73) + chr(78) + chr(73) + chr(95) + chr(65) + chr(80) + chr(73) + chr(95) + chr(75) + chr(69) + chr(89))))"'
                        }
                    } catch (Exception e) {
                        echo 'AI analysis could not complete. The test failure remains unchanged.'
                    }
                }
            }
        }
    }
}
